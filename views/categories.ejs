<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Categories | 100 Educators</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <a href="/" class="logo">
            <img src="/image/100-educators-logo.jpeg" alt="100 Educators">
        </a>

        <nav>
            <a href="/">Home</a>
            <a href="/explore" target="_blank">Explore</a>
            <a href="/categories" target="_blank">Categories</a>
            <a href="/institutes" target="_blank">For Institutes</a>
            <a href="/about" target="_blank">About</a>
        </nav>
    </header>


    <main>

