        <section class="hero">

            <p class="hero-label">CATEGORIES</p>

            <h1>
                Choose what<br>
                you want to learn.
            </h1>

            <p class="hero-text">
                Explore coaching, training and skill-development
                opportunities across competitive exams, government
                careers, technology, vocational skills and more.
            </p>

        </section>


        <!-- CATEGORIES -->

        <section class="categories-section">

            <div class="section-heading">

                <p>EXPLORE BY CATEGORY</p>

