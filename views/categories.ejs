                </h2>

            </div>


            <div class="categories-grid">


                <!-- 01 -->

                <a href="/explore?skill=JEE"
                   target="_blank"
                   class="category-card">

                    <span>🎯</span>

                    <h3>
                        Competitive Exams
                    </h3>

                    <p>
                        JEE, NEET, UPSC, UKPSC, SSC,
                        Banking and other competitive exams.
                    </p>

                </a>


                <!-- 02 -->

                <a href="/explore?skill=Government"
                   target="_blank"
                   class="category-card">

                    <span>🏛️</span>

                    <h3>
                        Government & Public Jobs
                    </h3>

                    <p>
                        Coaching and preparation for government
                        jobs, civil services, defence, railways
                        and other public-sector opportunities.
                    </p>

                </a>


                <!-- 03 -->

                <a href="/explore?skill=Banking"
                   target="_blank"
                   class="category-card">

                    <span>💼</span>

                    <h3>
                        Banking & Finance
                    </h3>

                    <p>
                        Banking exams, finance, accounting and
                        career-focused financial training.
                    </p>

                </a>


                <!-- 04 -->

                <a href="/explore?skill=Coding"
                   target="_blank"
                   class="category-card">

                    <span>💻</span>

                    <h3>
                        Coding & Technology
                    </h3>

                    <p>
                        Coding, programming, computers,
                        software development and technology skills.
                    </p>

                </a>


                <!-- 05 -->

                <a href="/explore?skill=AI"
                   target="_blank"
                   class="category-card">

                    <span>🤖</span>

                    <h3>
                        AI & Robotics
                    </h3>

                    <p>
                        Artificial intelligence, robotics,
                        automation and emerging technologies.
                    </p>

                </a>


                <!-- 06 -->

                <a href="/explore?skill=Skill"
                   target="_blank"
                   class="category-card">

                    <span>🛠️</span>

                    <h3>
                        Skill Development
                    </h3>

                    <p>
                        Practical and career-focused skills
                        for students, professionals and job seekers.
                    </p>

                </a>


                <!-- 07 -->

                <a href="/explore?skill=Vocational"
                   target="_blank"
                   class="category-card">

                    <span>🔧</span>

                    <h3>
                        Vocational Training
                    </h3>

                    <p>
                        Job-oriented technical training,
                        vocational courses and practical learning.
                    </p>

                </a>


                <!-- 08 -->

                <a href="/explore?skill=Career"
                   target="_blank"
                   class="category-card">

                    <span>🚀</span>

                    <h3>
                        Career & Professional Skills
                    </h3>

                    <p>
                        Career preparation, communication,
                        entrepreneurship and professional development.
                    </p>

                </a>


