<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>100 Educator | Find the Right Learning Institute</title>

    <link rel="stylesheet" href="/css/style.css">

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Icons -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        /* =====================================================
           100 EDUCATORS - HOMEPAGE PREMIUM UI
        ===================================================== */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: "Inter", sans-serif;
            color: #14213d;
            background: #f7f9fc;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        /* ================= HEADER ================= */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;

            height: 78px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 6%;

            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(16px);

            border-bottom: 1px solid rgba(20,33,61,0.08);

            transition: 0.3s ease;
        }

        header:hover {
            background: rgba(255,255,255,0.98);
        }

        .logo {
            display: flex;
            align-items: center;
        }

        .logo img {
            width: 150px;
            height: 62px;
            object-fit: contain;

            mix-blend-mode: multiply;

            transition: transform 0.3s ease;
        }

        .logo:hover img {
            transform: scale(1.04);
        }

        nav {
            display: flex;
            align-items: center;
            gap: 34px;
        }

        nav a {
            position: relative;

            color: #1b2a4a;

            font-size: 14px;
            font-weight: 600;

            transition: 0.3s ease;
        }

        nav a::after {
            content: "";

            position: absolute;
            left: 50%;
            bottom: -9px;

            width: 0;
            height: 2px;

            background: #246bfe;

            transform: translateX(-50%);

            transition: 0.3s ease;
        }

        nav a:hover {
            color: #246bfe;
        }

        nav a:hover::after {
            width: 100%;
        }

        /* ================= HERO ================= */

        .hero {
            position: relative;

            min-height: 650px;

            display: flex;
            flex-direction: column;
            justify-content: center;

            padding: 100px 8% 90px;

            overflow: hidden;

            background:
                radial-gradient(circle at 85% 20%, rgba(36,107,254,0.16), transparent 28%),
                radial-gradient(circle at 10% 80%, rgba(255,193,7,0.10), transparent 25%),
                linear-gradient(135deg, #f7faff, #eef4ff);
        }

        .hero::before {
            content: "";

            position: absolute;

            width: 430px;
            height: 430px;

            right: -150px;
            top: -100px;

            border-radius: 50%;

            background: rgba(36,107,254,0.08);

            animation: floatingCircle 7s ease-in-out infinite;
        }

        .hero::after {
            content: "";

            position: absolute;

            width: 180px;
            height: 180px;

            left: -60px;
            bottom: -70px;

            border-radius: 50%;

            border: 30px solid rgba(255,193,7,0.10);

            animation: floatingCircle 6s ease-in-out infinite reverse;
        }

        .hero-content {
            position: relative;
            z-index: 2;

            max-width: 850px;

            animation: heroReveal 0.9s ease forwards;
        }

        .hero-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            margin-bottom: 22px;

            padding: 9px 16px;

            border-radius: 30px;

            color: #246bfe;

            background: rgba(36,107,254,0.09);

            font-size: 12px;
            font-weight: 800;

            letter-spacing: 1.8px;
        }

        .hero-label i {
            font-size: 13px;
        }

        .hero h1 {
            margin: 0;

            max-width: 800px;

            font-family: "Plus Jakarta Sans", sans-serif;

            font-size: clamp(48px, 6vw, 82px);

            line-height: 1.04;

            letter-spacing: -3px;

            color: #14213d;
        }

        .hero h1 span {
            color: #246bfe;
            position: relative;
        }

        .hero h1 span::after {
            content: "";

            position: absolute;

            left: 0;
            bottom: -8px;

            width: 100%;
            height: 7px;

            border-radius: 10px;

            background: #ffc107;

            transform: scaleX(0);
            transform-origin: left;

            animation: underlineReveal 1s 0.8s ease forwards;
        }

        .hero-text {
            max-width: 680px;

            margin: 28px 0 35px;

            color: #53627b;

            font-size: 17px;
            line-height: 1.8;
        }

        /* ================= SEARCH ================= */

        .search-box {
            position: relative;
            z-index: 5;

            display: flex;
            align-items: stretch;

            max-width: 850px;

            padding: 8px;

            background: white;

            border-radius: 18px;

            box-shadow:
                0 20px 60px rgba(20,33,61,0.12),
                0 3px 10px rgba(20,33,61,0.05);

            border: 1px solid rgba(20,33,61,0.06);

            transition: 0.35s ease;
        }

        .search-box:focus-within {
            transform: translateY(-3px);

            box-shadow:
                0 25px 70px rgba(36,107,254,0.17),
                0 3px 15px rgba(20,33,61,0.06);
        }

        .search-field {
            flex: 1;

            display: flex;
            flex-direction: column;

            padding: 10px 18px;

            border-right: 1px solid #e8edf5;
        }

        .search-field span {
            margin-bottom: 5px;

            color: #8b96aa;

            font-size: 11px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .search-field input {
            width: 100%;

            border: none;
            outline: none;

            color: #17233d;

            font-size: 15px;

            background: transparent;
        }

        .search-field input::placeholder {
            color: #9ba5b5;
        }

        .search-box button {
            min-width: 135px;

            border: none;
            border-radius: 13px;

            background: #246bfe;
            color: white;

            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            transition: 0.3s ease;
        }

        .search-box button:hover {
            background: #1456dd;

            transform: translateY(-2px);

            box-shadow: 0 10px 25px rgba(36,107,254,0.25);
        }

        .search-box button i {
            margin-left: 8px;

            transition: 0.3s ease;
        }

        .search-box button:hover i {
            transform: translateX(5px);
        }

        /* ================= POPULAR SEARCH ================= */

        .popular-searches {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 9px;

            margin-top: 20px;
        }

        .popular-label {
            color: #78849a;

            font-size: 13px;
            font-weight: 600;
        }

        .popular-searches a {
            padding: 7px 13px;

            border: 1px solid #dfe6f1;

            border-radius: 30px;

            color: #40516e;

            background: white;

            font-size: 12px;
            font-weight: 600;

            transition: 0.3s ease;
        }

        .popular-searches a:hover {
            color: white;
            background: #246bfe;
            border-color: #246bfe;

            transform: translateY(-3px);
        }

        /* ================= SECTIONS ================= */

        .categories,
        .institute-section {
            padding: 100px 7%;
        }

        .categories {
            background: white;
        }

        .section-heading {
            margin-bottom: 45px;
        }

        .section-heading p {
            margin: 0 0 8px;

            color: #246bfe;

            font-size: 12px;
            font-weight: 800;

            letter-spacing: 2px;
        }

        .section-heading h2 {
            margin: 0;

            color: #14213d;

            font-family: "Plus Jakarta Sans", sans-serif;

            font-size: clamp(30px, 4vw, 46px);

            letter-spacing: -1.5px;
        }

        /* ================= CATEGORY CARDS ================= */

        .category-grid {
            display: grid;

            grid-template-columns: repeat(4, 1fr);

            gap: 20px;
        }

        .category-card {
            position: relative;

            min-height: 245px;

            display: flex;
            flex-direction: column;

            padding: 28px;

            overflow: hidden;

            border: 1px solid #e7ebf2;
            border-radius: 20px;

            background: #ffffff;

            transition:
                transform 0.35s ease,
                box-shadow 0.35s ease,
                border-color 0.35s ease;
        }

        .category-card::before {
            content: "";

            position: absolute;

            width: 100px;
            height: 100px;

            right: -35px;
            top: -35px;

            border-radius: 50%;

            background: rgba(36,107,254,0.06);

            transition: 0.4s ease;
        }

        .category-card:hover {
            transform: translateY(-10px);

            border-color: rgba(36,107,254,0.25);

            box-shadow: 0 20px 45px rgba(20,33,61,0.10);
        }

        .category-card:hover::before {
            width: 160px;
            height: 160px;
        }

        .category-number {
            color: #246bfe;

            font-size: 12px;
            font-weight: 800;

            letter-spacing: 1px;
        }

        .category-card h3 {
            margin: 35px 0 12px;

            color: #182640;

            font-size: 20px;
        }

        .category-card p {
            margin: 0;

            color: #6e7a90;

            font-size: 13px;

            line-height: 1.7;
        }

        .category-link {
            margin-top: auto;
            padding-top: 22px;

            color: #246bfe;

            font-size: 13px;
            font-weight: 700;
        }

        /* ================= TOP INSTITUTES ================= */

        .top-institutes {
            margin-bottom: 70px;
        }

        .top-institutes h2 {
            margin: 0 0 30px;

            font-family: "Plus Jakarta Sans", sans-serif;

            font-size: 36px;
            color: #14213d;
        }

        .institute-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 22px;

            margin-bottom: 45px;
        }

        .institute-card {
            position: relative;

            padding: 28px;

            background: white;

            border: 1px solid #e4e9f2;

            border-radius: 20px;

            box-shadow: 0 8px 25px rgba(20,33,61,0.05);

            transition: 0.35s ease;
        }

        .institute-card:hover {
            transform: translateY(-7px);

            box-shadow: 0 20px 45px rgba(20,33,61,0.11);

            border-color: rgba(36,107,254,0.25);
        }

        .institute-label {
            display: inline-block;

            margin-bottom: 15px;

            padding: 6px 10px;

            border-radius: 20px;

            color: #246bfe;

            background: #edf3ff;

            font-size: 10px;
            font-weight: 800;

            letter-spacing: 1px;
        }

        .institute-card h3 {
            margin: 0 0 15px;

            color: #17233d;

            font-size: 19px;
        }

        .institute-card p {
            color: #69758a;

            font-size: 13px;

            line-height: 1.6;
        }

        .institute-location {
            color: #52617a !important;
        }

        .educator-score {
            color: #246bfe !important;
        }

        .institute-link {
            display: inline-block;

            margin-top: 10px;

            color: #246bfe;

            font-size: 13px;
            font-weight: 700;

            transition: 0.3s ease;
        }

        .institute-link:hover {
            transform: translateX(5px);
        }

        .institute-rating {
            color: #4e5c73;
        }

        .verified-badge {
            color: #149447 !important;

            font-size: 12px !important;

            font-weight: 700;
        }

        .provisional-score {
            color: #9b7a00;

            font-size: 11px;
        }

        /* ================= FILTER ================= */

        .institute-filters {
            display: flex;
            gap: 12px;

            margin: 30px 0;
        }

        .institute-filters a {
            padding: 11px 18px;

            border-radius: 30px;

            color: #40516e;

            background: white;

            border: 1px solid #dfe5ef;

            font-size: 13px;
            font-weight: 700;

            transition: 0.3s ease;
        }

        .institute-filters a:hover {
            color: white;

            background: #246bfe;

            border-color: #246bfe;
        }

        .section-note {
            margin-top: -20px;
            margin-bottom: 25px;

            color: #78849a;

            font-size: 13px;
        }

        /* ================= FOOTER ================= */

        .site-footer {
            position: relative;

            padding: 75px 7% 25px;

            overflow: hidden;

            color: white;

            background:
                radial-gradient(circle at 90% 10%, rgba(36,107,254,0.25), transparent 25%),
                #101c35;
        }

        .site-footer::after {
            content: "";

            position: absolute;

            right: -100px;
            bottom: -130px;

            width: 330px;
            height: 330px;

            border: 70px solid rgba(255,193,7,0.10);

            border-radius: 50%;
        }

        .footer-container {
            position: relative;
            z-index: 2;

            display: grid;

            grid-template-columns: 1.4fr 1fr 1fr 1.3fr;

            gap: 55px;
        }

        .footer-brand img {
            width: 165px;
            height: 65px;

            object-fit: contain;

            background: white;

            border-radius: 8px;

            margin-bottom: 18px;
        }

        .footer-brand p {
            max-width: 280px;

            color: #aab6ca;

            font-size: 13px;

            line-height: 1.8;
        }

        .footer-column h3 {
            margin: 0 0 20px;

            color: white;

            font-size: 15px;
        }

        .footer-column a {
            display: block;

            margin-bottom: 12px;

            color: #aab6ca;

            font-size: 13px;

            transition: 0.25s ease;
        }

        .footer-column a:hover {
            color: white;

            transform: translateX(5px);
        }

        .footer-contact p {
            margin: 0 0 13px;

            color: #aab6ca;

            font-size: 13px;
        }

        .footer-contact i {
            width: 22px;

            color: #ffc107;
        }

        .social-links {
            display: flex;

            gap: 10px;

            margin-top: 20px;
        }

        .social-links a {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin: 0;

            border-radius: 50%;

            color: white;

            background: rgba(255,255,255,0.08);

            transition: 0.3s ease;
        }

        .social-links a:hover {
            background: #246bfe;

            transform: translateY(-4px);
        }

        .footer-bottom {
            position: relative;
            z-index: 2;

            display: flex;
            justify-content: space-between;

            margin-top: 50px;
            padding-top: 22px;

            border-top: 1px solid rgba(255,255,255,0.10);

            color: #8794aa;

            font-size: 12px;
        }

        /* ================= MOTION ================= */

        @keyframes heroReveal {

            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        @keyframes underlineReveal {

            to {
                transform: scaleX(1);
            }

        }

        @keyframes floatingCircle {

            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(20px) rotate(8deg);
            }

        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 1000px) {

            .category-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .institute-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-container {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media (max-width: 750px) {

            header {
                padding: 0 5%;
            }

            nav {
                gap: 15px;
            }

            nav a {
                font-size: 12px;
            }

            .hero {
                padding: 80px 6%;
            }

            .hero h1 {
                font-size: 48px;
                letter-spacing: -2px;
            }

            .search-box {
                flex-direction: column;
            }

            .search-field {
                border-right: none;
                border-bottom: 1px solid #e8edf5;
            }

            .search-box button {
                min-height: 50px;
            }

            .categories,
            .institute-section {
                padding: 70px 6%;
            }

            .category-grid,
            .institute-grid {
                grid-template-columns: 1fr;
            }

            .footer-container {
                grid-template-columns: 1fr;
                gap: 35px;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 10px;
            }

        }

    </style>
</head>

<body>

<!-- =====================================================
     HEADER
===================================================== -->

<header>
<a href="/" class="logo">
    <canvas id="logoCanvas" aria-label="100 Educators"></canvas>
</a>

    <nav>

        <a href="/">
            Home
        </a>

        <a href="/explore">
            Explore
        </a>

        <a href="/categories">
            Categories
        </a>

        <a href="/institutes">
            For Institutes
        </a>

        <a href="/about">
            About
        </a>

    </nav>

</header>


<main>

<!-- =====================================================
     HERO
===================================================== -->

<section class="hero">

    <div class="hero-content">

        <p class="hero-label">
            <i class="fa-solid fa-sparkles"></i>
            LEARNING • SKILLS • OPPORTUNITIES
        </p>

        <h1>
            Find the right
            <span>place to learn.</span>
        </h1>

        <p class="hero-text">
            Discover coaching centres, training institutes and
            learning opportunities based on what you want to learn
            and where you want to learn.
        </p>


        <form action="/explore" method="GET" class="search-box">

            <div class="search-field">

                <span>
                    What do you want to learn?
                </span>

                <input
                    type="text"
                    name="skill"
                    placeholder="JEE, SSC, Coding, AI..."
                >

            </div>


            <div class="search-field">

                <span>
                    Where?
                </span>

                <input
                    type="text"
                    name="location"
                    placeholder="City or area"
                >

            </div>


            <button type="submit">

                Search

                <i class="fa-solid fa-arrow-right"></i>

            </button>

        </form>


        <div class="popular-searches">

            <span class="popular-label">
                Popular:
            </span>

            <a href="/explore?skill=JEE">
                JEE
            </a>

            <a href="/explore?skill=NEET">
                NEET
            </a>

            <a href="/explore?skill=SSC">
                SSC
            </a>

            <a href="/explore?skill=Banking">
                Banking
            </a>

            <a href="/explore?skill=Coding">
                Coding
            </a>

            <a href="/explore?skill=AI">
                AI & Robotics
            </a>

        </div>

    </div>

</section>


<!-- =====================================================
     CATEGORIES
===================================================== -->

<section class="categories">

    <div class="section-heading">

        <p>
            EXPLORE
        </p>

        <h2>
            What are you looking for?
        </h2>

    </div>


    <div class="category-grid">

<a href="/explore?category=competitive-exams"
   class="category-card">
            <span class="category-number">
                01
            </span>

            <h3>
                Competitive Exams
            </h3>

            <p>
                JEE, NEET, UPSC, UKPSC, SSC, Banking
                and other competitive exams.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>


        <!-- Government & Public Jobs -->
<a href="/explore?category=government"
   class="category-card">
            <span class="category-number">
                02
            </span>

            <h3>
                Government & Public Jobs
            </h3>

            <p>
                Government jobs, civil services, defence,
                railways and other public-sector opportunities.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>


       <!-- Banking & Finance -->
<a href="/explore?category=banking"
   class="category-card">

            <span class="category-number">
                03
            </span>

            <h3>
                Banking & Finance
            </h3>

            <p>
                Banking exams, finance, accounting
                and financial career training.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>


       <!-- Coding & Technology -->
<a href="/explore?category=technology"
   class="category-card">

            <span class="category-number">
                04
            </span>

            <h3>
                Coding & Technology
            </h3>

            <p>
                Coding, programming, computers,
                software and technology skills.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>

<!-- AI & Robotics -->
<a href="/explore?category=ai-robotics"
   class="category-card">

            <span class="category-number">
                05
            </span>

            <h3>
                AI & Robotics
            </h3>

            <p>
                Artificial intelligence, robotics,
                automation and emerging technologies.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>

<!-- Skill Development -->
<a href="/explore?category=skill-development"
   class="category-card">

            <span class="category-number">
                06
            </span>

            <h3>
                Skill Development
            </h3>

            <p>
                Practical and career-focused skills
                for students, professionals and job seekers.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>


       <!-- Vocational Training -->
<a href="/explore?category=vocational"
   class="category-card">
            <span class="category-number">
                07
            </span>

            <h3>
                Vocational Training
            </h3>

            <p>
                Job-oriented technical training,
                vocational courses and practical learning.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>


        <!-- Career & Professional Skills -->
<a href="/explore?category=career"
   class="category-card">

            <span class="category-number">
                08
            </span>

            <h3>
                Career & Professional Skills
            </h3>

            <p>
                Career preparation, communication,
                entrepreneurship and professional development.
            </p>

            <span class="category-link">
                Explore →
            </span>

        </a>


    </div>

</section>


<!-- =====================================================
     INSTITUTES
===================================================== -->

<section class="institute-section">


    <div class="section-heading">

        <p>
            LEARNING CENTRES
        </p>

        <h2>
            Institutes near you
        </h2>

    </div>


    <!-- TOP INSTITUTES -->

    <section class="top-institutes">

        <p class="hero-label">
