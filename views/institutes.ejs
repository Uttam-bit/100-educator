<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>For Institutes | 100 Educator</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header class="site-header">

        <div class="logo">
            <a href="/">
                <img src="/image/100-educators-logo.jpeg" alt="100 Educator">
            </a>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/explore">Explore</a>
            <a href="/categories">Categories</a>
            <a href="/institutes">For Institutes</a>
            <a href="/about">About</a>
        </nav>

    </header>

    <main>

        <section class="hero">

            <p class="hero-label">FOR INSTITUTES</p>

            <h1>Get your institute<br>discovered.</h1>

            <p class="hero-text">
                Join 100 Educator and help students discover
                your coaching centre, training institute or
                skill development centre.
            </p>

        </section>

        <section class="institute-join-section">

            <div class="section-heading">
                <p>GROW WITH 100 EDUCATOR</p>

                <h2>Why list your institute?</h2>
            </div>

            <div class="institute-benefits">

                <div class="benefit-card">
                    <span>🔎</span>
                    <h3>Be Discoverable</h3>
                    <p>
                        Help students and parents find your
                        institute when searching for courses
                        and skills.
                    </p>
                </div>

                <div class="benefit-card">
                    <span>📊</span>
                    <h3>Showcase Your Institute</h3>
                    <p>
                        Display your courses, location, fees,
                        ratings and important institute details.
                    </p>
                </div>

                <div class="benefit-card">
                    <span>🚀</span>
                    <h3>Reach More Students</h3>
                    <p>
                        Build your online presence and connect
                        with students looking for the right
                        learning opportunity.
                    </p>
                </div>

            </div>

            <div class="institute-cta">

                <h2>Want to list your institute?</h2>

                <p>
                    Get in touch with 100 Educator to add your
                    institute to our growing learning directory.
                </p>

                <a href="mailto:info@100educator.com" class="details-button">
                    Contact 100 Educator →
                </a>

            </div>

        </section>

    </main>

</body>

</html>