<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Us | 100 Educators</title>

    <meta name="description" content="Contact 100 Educators for general queries, institute information, suggestions and corrections.">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <a href="/" class="logo">
            <img src="/image/100-educators-logo.jpeg" alt="100 Educators">
        </a>

        <nav>
            <a href="/">Home</a>
            <a href="/explore" target="_blank">Explore</a>
            <a href="/categories" target="_blank">Categories</a>
            <a href="/institutes" target="_blank">For Institutes</a>
            <a href="/about" target="_blank">About</a>
            <a href="/contact">Contact</a>
        </nav>
    </header>


    <main>

        <section class="contact-page">

            <div class="contact-container">

                <!-- CONTACT PAGE INTRO -->

                <div class="contact-heading">

                    <p class="hero-label">GET IN TOUCH</p>

                    <h1>Contact Us</h1>

                    <p>
                        Have a question, suggestion or want to connect with
                        100 Educators? Send us a message and we will get back
                        to you.
                    </p>

                </div>


                <!-- CONTACT INFORMATION + FORM -->

                <div class="contact-layout">


                    <!-- LEFT SIDE -->

                    <div class="contact-info">


                        <div class="contact-card">

                            <span class="contact-card-label">
                                01
                            </span>

                            <h3>General Queries</h3>

                            <p>
                                Have a question about 100 Educators, institutes,
                                courses or how the platform works? Feel free
                                to contact us.
                            </p>

                        </div>


                        <div class="contact-card">

                            <span class="contact-card-label">
                                02
                            </span>

                            <h3>Institute Information</h3>

                            <p>
                                If you represent a coaching centre, training
                                institute or skill-learning organisation and
                                want to provide or update information, get in
                                touch with us.
                            </p>

                        </div>


                        <div class="contact-card">

                            <span class="contact-card-label">
                                03
                            </span>

                            <h3>Suggestions & Corrections</h3>

                            <p>
                                Found incorrect information or have an idea
                                that can improve 100 Educators? We welcome
                                your suggestions and feedback.
                            </p>

                        </div>


                        <!-- CONTACT DETAILS -->

                        <div class="contact-card contact-details">

                            <span class="contact-card-label">
                                CONTACT INFORMATION
                            </span>

                            <h3>Get in Touch</h3>


                            <div class="contact-detail-item">

                                <strong>📍 Address</strong>

                                <p>
                                    Blackwings Tower,<br>
                                    Prem Nagar, Dehradun
                                </p>

                            </div>


                            <div class="contact-detail-item">

                                <strong>📞 Phone</strong>

                                <p>
                                    <a href="tel:7007118586">
                                        7007118586
                                    </a>
                                </p>

                            </div>


                            <div class="contact-detail-item">

                                <strong>✉ Email</strong>

                                <p>
                                    <a href="mailto:100educators.com@gmail.com">
                                        100educators.com@gmail.com
                                    </a>
                                </p>

                            </div>


                            <div class="contact-detail-item">

                                <strong>🌐 Website</strong>

                                <p>
                                    100educators.com
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- RIGHT SIDE FORM -->

                    <div class="contact-form-box">

                        <h2>Send Us a Message</h2>

                        <form action="/contact" method="POST" class="contact-form">


                            <label>
                                Name

                                <input
                                    type="text"
                                    name="name"
                                    placeholder="Enter your name"
                                    required
                                >

                            </label>


                            <label>
                                Email Address

                                <input
                                    type="email"
                                    name="email"
                                    placeholder="Enter your email address"
                                    required
                                >

                            </label>


                            <label>
                                Subject

                                <input
                                    type="text"
                                    name="subject"
                                    placeholder="Enter subject"
                                    required
                                >

                            </label>


                            <label>
                                Message

                                <textarea
                                    name="message"
                                    placeholder="Write your message..."
                                    required
                                ></textarea>

                            </label>


                            <button
                                type="submit"
                                class="contact-submit-btn"
                            >
                                Send Message
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </section>

    </main>

</body>
</html>